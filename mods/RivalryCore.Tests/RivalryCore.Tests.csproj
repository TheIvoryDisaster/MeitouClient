<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rivalry Core's tests (docs/modding-rivalry.md): synthetic worlds only, no game install needed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Rivalry.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Meitou.Game/Meitou.Game.csproj" />
    <ProjectReference Include="../RivalryCore/RivalryCore.csproj" />
  </ItemGroup>

</Project>
